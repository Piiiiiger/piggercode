{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PiggerCode (dev)",
  "mainBinaryName": "piggercode-desktop-dev",
  "identifier": "dev.piggercode.app.publicdev",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["piggercode-dev"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNDFGOTk1OUM0RDE3QUM2RApSV1J0ckJkTm5KWDVRUjJhbFRoSm9UdnRrWEFKdU9OeEJ3UXF0ZXNSKzJwYjFRa1ErZEZ1Q1dMbQo=",
      "endpoints": [
        "https://github.com/Piiiiiger/piggercode/releases/download/ui-desktop-dev/latest.json"
      ]
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "pet_overlay"
      ]
    },
    "windows": [
      {
