{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PiggerCode",
  "mainBinaryName": "piggercode-desktop",
  "version": "0.3.11",
  "identifier": "dev.piggercode.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:dev",
    "beforeBuildCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "default",
        "pet_overlay"
      ],
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PiggerCode",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#F5F5F5",
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "category": "DeveloperTool",
    "publisher": "PiggerCode",
    "shortDescription": "A cross-device companion for coding agents",
    "longDescription": "Monitor, steer, approve, review, and continue coding agent sessions across your computers, phone, and browser.",
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "externalBin": [
      "binaries/hsetup"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "../../../scripts/pipeline/release/bun-standalone.entitlements.plist",
      "dmg": {
        "background": "./dmg/dmg-background.png",
        "windowSize": {
          "width": 623,
          "height": 602
        },
        "appPosition": {
          "x": 169,
          "y": 305
        },
        "applicationFolderPosition": {
          "x": 451,
          "y": 305
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "piggercode"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNDFGOTk1OUM0RDE3QUM2RApSV1J0ckJkTm5KWDVRUjJhbFRoSm9UdnRrWEFKdU9OeEJ3UXF0ZXNSKzJwYjFRa1ErZEZ1Q1dMbQo=",
      "endpoints": [
        "https://github.com/Piiiiiger/piggercode/releases/download/ui-desktop-stable/latest.json"
      ]
    }
  }
}
