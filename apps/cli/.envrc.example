# PiggerCode CLI development environment
#
# This file is for direnv users who want automatic environment switching
# when entering this directory.
#
# Setup:
#   1. Install direnv: https://direnv.net/
#   2. Copy this file: cp .envrc.example .envrc
#   3. Run: direnv allow
#
# The .envrc file is gitignored, so each developer can customize it.

export PIGGERCODE_HOME_DIR="$HOME/.piggercode-dev"
export PIGGERCODE_VARIANT="dev"
export PIGGERCODE_SERVER_URL="${PIGGERCODE_SERVER_URL:-http://localhost:3005}"

echo "🔧 DEV environment activated (data: $PIGGERCODE_HOME_DIR)"
