{
  "v": 1,
  "id": "agy",
  "enableEnvVar": "PIGGERCODE_E2E_PROVIDER_AGY",
  "protocol": "acp",
  "traceProvider": "agy",
  "auth": { "mode": "host" },
  "cli": {
    "subcommand": "agy",
    "extraArgs": ["--started-by", "terminal"],
    "env": { "HEADLESS": "1", "PIGGERCODE_VARIANT": "dev" }
  }
}
