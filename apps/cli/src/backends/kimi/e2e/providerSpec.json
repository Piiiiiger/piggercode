{
  "v": 1,
  "id": "kimi",
  "enableEnvVar": "PIGGERCODE_E2E_PROVIDER_KIMI",
  "protocol": "acp",
  "traceProvider": "kimi",
  "requiredBinaries": [{ "bin": "kimi", "envOverride": "PIGGERCODE_E2E_PROVIDER_KIMI_BIN", "requireExists": true }],
  "auth": { "mode": "host" },
  "cli": {
    "subcommand": "kimi",
    "extraArgs": ["--started-by", "terminal"],
    "env": { "HEADLESS": "1", "PIGGERCODE_VARIANT": "dev" },
    "envFrom": { "PIGGERCODE_KIMI_PATH": "PIGGERCODE_E2E_PROVIDER_KIMI_BIN" }
  }
}
